{
  "$id": "https://unpkg.com/@archreel/schema/archreel.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "JSON Schema URL, for editors",
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "theme": {
      "default": "dark",
      "description": "\"dark\", \"light\", or { base, colors } to override colors",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "dark",
            "light"
          ]
        },
        {
          "type": "object",
          "properties": {
            "base": {
              "default": "dark",
              "description": "Theme to start from",
              "type": "string",
              "enum": [
                "dark",
                "light"
              ]
            },
            "colors": {
              "default": {},
              "description": "Hex color overrides",
              "type": "object",
              "properties": {
                "background": {
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                },
                "node": {
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                },
                "nodeBorder": {
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                },
                "text": {
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                },
                "mutedText": {
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                },
                "edge": {
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                },
                "packet": {
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                },
                "packetText": {
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                },
                "groupFill": {
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                },
                "groupBorder": {
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                },
                "danger": {
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                },
                "highlight": {
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                },
                "captionFill": {
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "canvas": {
      "default": {
        "width": 1920,
        "height": 1080,
        "fps": 30
      },
      "type": "object",
      "properties": {
        "width": {
          "default": 1920,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 7680,
          "multipleOf": 2
        },
        "height": {
          "default": 1080,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 7680,
          "multipleOf": 2
        },
        "fps": {
          "default": 30,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 60
        }
      },
      "additionalProperties": false
    },
    "nodes": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Identifier referenced by edges and steps"
          },
          "label": {
            "description": "Display text; defaults to id",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "icon": {
            "type": "string",
            "enum": [
              "user",
              "server",
              "database",
              "cache",
              "queue",
              "aws/alb",
              "aws/s3",
              "k8s/pod",
              "redis",
              "postgres",
              "kafka"
            ]
          },
          "group": {
            "description": "Id of the group this node sits in",
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "position": {
            "description": "Manual position override in canvas pixels; skips auto-layout",
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    "groups": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Identifier referenced by edges and steps"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "default": [],
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Identifier referenced by edges and steps"
          },
          "to": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Identifier referenced by edges and steps"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "maxItems": 2000,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "reveal": {
                "minItems": 1,
                "maxItems": 500,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                  "description": "Identifier referenced by edges and steps"
                },
                "description": "Node or group ids to fade in"
              },
              "duration": {
                "description": "How long this step plays; defaults per step kind",
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "string",
                    "pattern": "^(\\d+(?:\\.\\d+)?)(ms|s)$"
                  }
                ]
              },
              "at": {
                "description": "Start this step when the phrase is spoken in the voiceover",
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "reveal"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "flow": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                    "description": "Identifier referenced by edges and steps"
                  },
                  "to": {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                    "description": "Identifier referenced by edges and steps"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "from",
                  "to"
                ],
                "additionalProperties": false
              },
              "duration": {
                "description": "How long this step plays; defaults per step kind",
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "string",
                    "pattern": "^(\\d+(?:\\.\\d+)?)(ms|s)$"
                  }
                ]
              },
              "at": {
                "description": "Start this step when the phrase is spoken in the voiceover",
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "flow"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "highlight": {
                "type": "object",
                "properties": {
                  "nodes": {
                    "minItems": 1,
                    "maxItems": 500,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                      "description": "Identifier referenced by edges and steps"
                    },
                    "description": "Node or group ids"
                  },
                  "caption": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "nodes"
                ],
                "additionalProperties": false
              },
              "duration": {
                "description": "How long this step plays; defaults per step kind",
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "string",
                    "pattern": "^(\\d+(?:\\.\\d+)?)(ms|s)$"
                  }
                ]
              },
              "at": {
                "description": "Start this step when the phrase is spoken in the voiceover",
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "highlight"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "fail": {
                "type": "object",
                "properties": {
                  "node": {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                    "description": "Node or group id"
                  },
                  "effect": {
                    "default": "shake",
                    "type": "string",
                    "enum": [
                      "shake",
                      "flash"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "node"
                ],
                "additionalProperties": false
              },
              "duration": {
                "description": "How long this step plays; defaults per step kind",
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "string",
                    "pattern": "^(\\d+(?:\\.\\d+)?)(ms|s)$"
                  }
                ]
              },
              "at": {
                "description": "Start this step when the phrase is spoken in the voiceover",
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "fail"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "pause": {
                "description": "Seconds as a number, or a string like \"1.2s\" or \"500ms\"",
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "string",
                    "pattern": "^(\\d+(?:\\.\\d+)?)(ms|s)$"
                  }
                ]
              },
              "at": {
                "description": "Start this step when the phrase is spoken in the voiceover",
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "pause"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "voiceover": {
      "type": "object",
      "properties": {
        "captions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Word timestamps: a JSON array of { text, startMs, endMs } (Remotion Caption)"
        },
        "audio": {
          "description": "Narration audio (mp3, wav, m4a, …)",
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "captions"
      ],
      "additionalProperties": false,
      "description": "Narration that steps can anchor to with `at`"
    }
  },
  "required": [
    "version",
    "nodes"
  ],
  "additionalProperties": false,
  "title": "archreel spec",
  "description": "Declarative architecture explainer video"
}
