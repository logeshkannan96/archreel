{
  "name": "@archreel/schema",
  "version": "0.1.0",
  "description": "Spec schema, validation and JSON Schema for archreel",
  "keywords": [
    "architecture",
    "system-design",
    "diagram",
    "json-schema",
    "zod"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logeshkannan96/archreel.git",
    "directory": "packages/schema"
  },
  "homepage": "https://github.com/logeshkannan96/archreel#readme",
  "bugs": {
    "url": "https://github.com/logeshkannan96/archreel/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./archreel.schema.json": "./archreel.schema.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "archreel.schema.json"
  ],
