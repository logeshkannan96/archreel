{
  "name": "@archreel/mermaid",
  "version": "0.1.0",
  "description": "Converts Mermaid flowcharts into archreel specs",
  "keywords": [
    "mermaid",
    "flowchart",
    "architecture",
    "diagram"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logeshkannan96/archreel.git",
    "directory": "packages/mermaid"
  },
  "homepage": "https://github.com/logeshkannan96/archreel#readme",
  "bugs": {
    "url": "https://github.com/logeshkannan96/archreel/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepack": "cp ../../LICENSE LICENSE"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@archreel/schema": "workspace:*"
  }
}
