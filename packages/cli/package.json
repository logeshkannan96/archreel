{
  "name": "archreel",
  "version": "0.1.0",
  "description": "Turn architecture specs into animated system-design videos",
  "keywords": [
    "architecture",
    "system-design",
    "diagram",
    "video",
    "animation",
    "remotion",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logeshkannan96/archreel.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/logeshkannan96/archreel#readme",
  "bugs": {
    "url": "https://github.com/logeshkannan96/archreel/issues"
  },
  "type": "module",
  "bin": {
    "archreel": "./dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepack": "cp ../../LICENSE LICENSE && cp ../../README.md README.md"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@archreel/layout": "workspace:*",
    "@archreel/mermaid": "workspace:*",
    "@archreel/remotion": "workspace:*",
    "@archreel/schema": "workspace:*",
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0"
  }
}
